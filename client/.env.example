# Frontend environment variables (copy to client/.env for local development).
# Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the REST API INCLUDING the /api suffix, e.g.:
#   VITE_API_URL=https://your-api.example.com/api
# Leave empty in development - the Vite dev server proxies /api and /uploads
# to http://localhost:5000 (see vite.config.js), so no CORS applies locally.
# Wrong example (breaks every request): https://your-api.example.com
VITE_API_URL=
