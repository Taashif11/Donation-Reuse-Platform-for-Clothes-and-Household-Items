# Server configuration - copy this file to server/.env and fill in real values.
# NEVER commit server/.env to git.

# Port the Express API listens on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/donation_reuse_platform

# Secret used to sign JWT access tokens - use a long random string in production.
# Rotate this value for every deployment; never commit the real secret.
JWT_SECRET=your_jwt_secret

# How long an access token stays valid (example: 7d, 1d, 3600)
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (exact origin, no trailing slash)
CLIENT_URL=http://localhost:5173

# Runtime mode. Set to `production` on your hosting platform (Render/Vercel/Railway
# usually set it automatically). Enables trust proxy + the strict JWT_SECRET check.
# Leave unset for local development.
# NODE_ENV=production

# Map/location API key (optional - the app runs without it)
MAP_API_KEY=your_map_api_key
