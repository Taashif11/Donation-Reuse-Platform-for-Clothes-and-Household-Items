# Copy this file to server/.env for local development.
# NEVER commit server/.env - it holds the real JWT secret and database credentials.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/donation_reuse_platform
# Use a long random string (32+ characters); production refuses to start with a weak one.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# Exact frontend origin allowed by CORS - no trailing slash.
CLIENT_URL=http://localhost:5173
# Optional - the app runs without it.
MAP_API_KEY=your_map_api_key
# Set to `production` on your hosting platform (leave unset locally).
# NODE_ENV=production
